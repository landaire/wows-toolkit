# Not wows_toolkit_gpui_bin: the target name is a path component of every
# object file a release build writes, and the longest of those already sits
# within a dozen characters of the 260 link.exe accepts.
workspace_binary(
    name = "gpui_bin",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.1.0-beta4",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    deps = GPUI_DEPS,
    # gpui embeds its application manifest from its own build script, which
    # shells out to an rc.exe it discovers from host state. Buck compiles the
    # same manifest with the pinned rc.exe and links the result here instead.
    rustc_flags = os_select(
        macos = [],
        linux = LINUX_GUI_RUSTC_FLAGS,
        windows = ["-Clink-arg=$(location toolchains//windows:gpui_app_resource)"],
    ),
)

# The shared crates' heap-sampling builds, which the dhat binary links instead.
_DHAT_VARIANTS = {
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data": "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data_dhat",
}

# The same binary with dhat's tracking allocator, for comparing this port's
# live heap against the egui app's. Name kept short: it is a path component of
# every object file, and the longest already sits near the 260 link.exe takes.
workspace_binary(
    name = "gpui_dhat",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.1.0-beta4",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    features = ["dhat-heap"],
    deps = [_DHAT_VARIANTS.get(d, d) for d in GPUI_DEPS] + ["//third-party/rust:dhat"],
    rustc_flags = os_select(
        macos = [],
        linux = LINUX_GUI_RUSTC_FLAGS,
        windows = ["-Clink-arg=$(location toolchains//windows:gpui_app_resource)"],
    ),
)

_TEST_SUPPORT_VARIANTS = {
    "//crates/wows-toolkit-armor:wows_toolkit_armor": "//crates/wows-toolkit-armor:wows_toolkit_armor_test_support",
    "//crates/wows-toolkit-config:wows_toolkit_config": "//crates/wows-toolkit-config:wows_toolkit_config_test_support",
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data": "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data_test_support",
    "//crates/wows-toolkit-services:wows_toolkit_services": "//crates/wows-toolkit-services:wows_toolkit_services_test_support",
    "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel": "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel_test_support",
}

# The transition builds the gpui crates with their test-support features (see
# //build-support/buck/test-support), which the binaries above never get.
workspace_test(
    name = "gpui_test",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.1.0-beta4",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    # test-support lets the tests point `storage_dir` at a temporary directory.
    deps = [_TEST_SUPPORT_VARIANTS.get(d, d) for d in GPUI_DEPS],
    test_deps = [
        "//third-party/rust:filetime",
        "//third-party/rust:tempfile",
    ],
    incoming_transition = "//build-support/buck/test-support:transition",
    # Each test opens a window and a graphics device. One thread per core
    # wedges the run on a machine with many of them.
    run_env = {"RUST_TEST_THREADS": "4"},
)
