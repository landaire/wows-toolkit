# Not wows_toolkit_gpui_bin: the target name is a path component of every
# object file a release build writes, and the longest of those already sits
# within a dozen characters of the 260 link.exe accepts.
workspace_binary(
    name = "gpui_bin",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.0.2-beta2",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    deps = GPUI_DEPS,
    # gpui embeds its application manifest from its own build script, which
    # shells out to an rc.exe it discovers from host state. Buck compiles the
    # same manifest with the pinned rc.exe and links the result here instead.
    rustc_flags = os_select(
        macos = [],
        linux = [],
        windows = ["-Clink-arg=$(location toolchains//windows:gpui_app_resource)"],
    ),
)

# The same binary with dhat's tracking allocator, for comparing this port's
# live heap against the egui app's. Name kept short: it is a path component of
# every object file, and the longest already sits near the 260 link.exe takes.
workspace_binary(
    name = "gpui_dhat",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.0.2-beta2",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    features = ["dhat-heap"],
    deps = GPUI_DEPS + ["//third-party/rust:dhat"],
    rustc_flags = os_select(
        macos = [],
        linux = [],
        windows = ["-Clink-arg=$(location toolchains//windows:gpui_app_resource)"],
    ),
)
