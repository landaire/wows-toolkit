load("//build-support/buck:workspace_rules.bzl", "os_select", "workspace_binary", "workspace_buildscript")

buildscript = workspace_buildscript(
    name = "gpui_build",
    crate = "wows_toolkit_gpui",
    package = "wows-toolkit-gpui",
    version = "1.0.2-beta2",
    rustc_flags = ["--cfg=wows_buck_build"],
    env = {"EMBEDDED_CONSTANTS": "$(location //embedded_resources:constants_json)"},
)

