# The cfg(windows) dependency section of Cargo.toml. Kept apart from ZGUI_DEPS because the test
# target maps that list, and a select cannot be iterated.
ZGUI_PLATFORM_DEPS = os_select(
    macos = [],
    linux = [],
    windows = ["//third-party/rust:windows-sys"],
)

# Not wows_toolkit_bin: the target name is a path component of every object file a release
# build writes, and the longest of those already sits near the 260 link.exe accepts.
workspace_binary(
    name = "zgui_bin",
    crate = "wows_toolkit",
    package = "wows-toolkit",
    version = "1.1.2",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    deps = ZGUI_DEPS + ZGUI_PLATFORM_DEPS,
    resources = os_select(macos = {}, linux = LINUX_WINE_HELPER_RESOURCES, windows = {}),
    rustc_flags = os_select(
        macos = [],
        linux = LINUX_GUI_RUSTC_FLAGS,
        # The release ships this binary and its PDB as wows_toolkit.exe and wows_toolkit.pdb. The
        # debug directory must name the shipped PDB, or a crash backtrace on a user's machine finds
        # no symbols beside the executable.
        windows = [
            "-Clink-arg=$(location toolchains//windows:app_resource)",
            "-Clink-arg=/PDBALTPATH:wows_toolkit.pdb",
        ],
    ),
)

_TEST_SUPPORT_VARIANTS = {
    "//crates/landaire-ui:landaire_ui": "//crates/landaire-ui:landaire_ui_test_support",
    "//crates/wows-toolkit-config:wows_toolkit_config": "//crates/wows-toolkit-config:wows_toolkit_config_test_support",
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data": "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data_test_support",
    "//crates/wows-toolkit-services:wows_toolkit_services": "//crates/wows-toolkit-services:wows_toolkit_services_test_support",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher": "//crates/wows-toolkit-launcher:wows_toolkit_launcher_test_support",
    "//crates/wows-toolkit-armor:wows_toolkit_armor": "//crates/wows-toolkit-armor:wows_toolkit_armor_test_support",
    "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel": "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel_test_support",
}

workspace_test(
    name = "zgui_test",
    crate = "wows_toolkit",
    package = "wows-toolkit",
    version = "1.1.2",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    # test-support lets the tests point `storage_dir` at a temporary directory and open the shell
    # headlessly.
    deps = [_TEST_SUPPORT_VARIANTS.get(d, d) for d in ZGUI_DEPS] + ZGUI_PLATFORM_DEPS,
    test_deps = ["//third-party/rust:tempfile"],
    # Each test opens a window. One thread per core wedges the run on a machine with many of them.
    run_env = {"RUST_TEST_THREADS": "4"},
    gui = True,
)
