buildscript = workspace_buildscript(
    name = "zgui_build",
    crate = "wows_toolkit",
    package = "wows-toolkit",
    version = "1.1.2",
    rustc_flags = ["--cfg=wows_buck_build"],
    env = {"WOWS_TOOLKIT_ICON": "$(location //assets:wows_toolkit_256_png)"},
)

