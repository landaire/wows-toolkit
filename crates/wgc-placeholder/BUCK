load("//build-support/buck:workspace_rules.bzl", "workspace_binary")
load("@toolchains//:hermetic_rust.bzl", "WINDOWS_HELPER_RUSTC_FLAGS", "windows_cross_compatible_with", "windows_cross_resource")

# build.rs compiles the same script under Cargo.
windows_cross_resource(
    name = "version_resource",
    src = "wgc.rc",
    out = "wgc_version.o",
    target_compatible_with = windows_cross_compatible_with(),
)

# No C runtime: the entry point is main.rs's own.
workspace_binary(
    name = "wgc_placeholder_bin",
    crate = "wgc_placeholder",
    package = "wgc-placeholder",
    version = "0.1.0",
    crate_root = "src/main.rs",
    incoming_transition = "//build-support/buck/windows_cross:transition",
    rustc_flags = WINDOWS_HELPER_RUSTC_FLAGS + [
        "--cfg=wows_buck_build",
        # Leaves out the C runtime startup objects the toolchain links.
        "-Clink-self-contained=no",
        "-Clink-arg=$(location :version_resource)",
        "-Clink-arg=--entry=wgc_placeholder_start",
    ],
    target_compatible_with = windows_cross_compatible_with(),
)
