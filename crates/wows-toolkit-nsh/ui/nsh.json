{
  "name": "WoWs Toolkit",
  "id": "dev.landaire.wows-toolkit-nsh",
  "version": "1.0.3",
  "appearance": "system",
  "theme": "theme.json",
  "capabilities": {
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "picker": true,
    "clipboard": true,
    "network": {
      "http": [
        {
          "host": "api.github.com",
          "methods": [
            "GET"
          ],
          "schemes": [
            "https"
          ],
          "pathPrefixes": [
            "/repos/landaire/wows-toolkit/releases"
          ]
        }
      ]
    }
  }
}
