NSH_PLATFORM_DEPS = os_select(
    macos = [],
    linux = ["//third-party/rust:nsh-platform-linux"],
    windows = [],
)

NSH_SHARED_DEPS = [
    "//crates/wows-toolkit-config:wows_toolkit_config",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher",
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data",
] + NSH_COMMON_DEPS

NSH_DEPS = NSH_SHARED_DEPS + NSH_PLATFORM_DEPS

# The test-support builds of the shared crates, so a test target links one
# build of each and not the shipping one beside it.
_TEST_SUPPORT_VARIANTS = {
    "//crates/wows-toolkit-armor:wows_toolkit_armor": "//crates/wows-toolkit-armor:wows_toolkit_armor_test_support",
    "//crates/wows-toolkit-config:wows_toolkit_config": "//crates/wows-toolkit-config:wows_toolkit_config_test_support",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher": "//crates/wows-toolkit-launcher:wows_toolkit_launcher_test_support",
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data": "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data_test_support",
    "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel": "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel_test_support",
}

NSH_TEST_DEPS = [_TEST_SUPPORT_VARIANTS.get(d, d) for d in NSH_SHARED_DEPS] + NSH_PLATFORM_DEPS

workspace_library(
    name = "wows_toolkit_nsh",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    env = {"CARGO_MANIFEST_DIR": "$(location :_cargo_manifest)/.."},
    deps = NSH_DEPS,
)

workspace_library(
    name = "wows_toolkit_nsh_test_support",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    features = ["test-support"],
    env = {"CARGO_MANIFEST_DIR": "$(location :_cargo_manifest)/.."},
    deps = NSH_TEST_DEPS,
)

workspace_test(
    name = "wows_toolkit_nsh_test",
    crate = "wows_toolkit_nsh",
    crate_root = "src/lib.rs",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    features = ["test-support"],
    deps = NSH_TEST_DEPS,
    test_deps = [
        "//third-party/rust:nsh-testing",
        "//third-party/rust:nsh-engine",
        "//third-party/rust:parking_lot",
    ],
)

workspace_integration_tests(
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    library = ":wows_toolkit_nsh_test_support",
    deps = NSH_TEST_DEPS,
    test_deps = [
        "//third-party/rust:nsh-testing",
        "//third-party/rust:nsh-engine",
