load("//build-support/buck:workspace_rules.bzl", "os_select", "workspace_integration_tests", "workspace_library", "workspace_test")

export_file(
    name = "_cargo_manifest",
    src = "Cargo.toml",
    mode = "reference",
    visibility = [],
)
genrule(
    name = "nsh_ui_bundle",
    srcs = glob(["ui/**"]),
    out = "bundle.js",
    cmd = "$(exe //build-support/nsh-bundle:nsh_bundle) $SRCDIR/ui/App.tsx $OUT",
    visibility = ["//crates/wows-toolkit-nsh-app/..."],
)

