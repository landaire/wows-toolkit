NSH_DEPS = [
    "//crates/wows-toolkit-config:wows_toolkit_config",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher",
] + NSH_COMMON_DEPS

NSH_TEST_DEPS = [
    "//crates/wows-toolkit-config:wows_toolkit_config_test_support",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher_test_support",
] + NSH_COMMON_DEPS

workspace_library(
    name = "wows_toolkit_nsh",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    env = {"CARGO_MANIFEST_DIR": "$(location :_cargo_manifest)/.."},
    deps = NSH_DEPS,
)

workspace_library(
    name = "wows_toolkit_nsh_test_support",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    env = {"CARGO_MANIFEST_DIR": "$(location :_cargo_manifest)/.."},
    deps = NSH_TEST_DEPS,
)

workspace_binary(
    name = "nsh_bin",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    crate_root = "src/main.rs",
    env = {"NSH_BUNDLE_PATH": "$(location :nsh_ui_bundle)"},
    features = ["buck"],
    resources = [":nsh_ui_bundle"],
    deps = NSH_DEPS + [":wows_toolkit_nsh"],
)

workspace_integration_tests(
    package = "wows-toolkit-nsh",
    version = "1.0.3",
    library = ":wows_toolkit_nsh_test_support",
    deps = NSH_TEST_DEPS,
    features = ["buck"],
    run_env = {"NSH_BUNDLE_PATH": "$(location :nsh_ui_bundle)"},
    test_deps = [
        "//third-party/rust:nsh-testing",
        "//third-party/rust:nsh-engine",
        "//third-party/rust:parking_lot",
    ],
)
