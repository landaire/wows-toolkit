)

WOWS_QUERY_TEST_DEPS = [
    "//third-party/rust:insta",
]

workspace_library(
    name = "wows_query",
    crate = "wows_query",
    package = "wows-query",
    version = "0.1.0",
    features = ["download"],
    deps = WOWS_QUERY_DEPS,
    buildscript = buildscript,
)

workspace_test(
    name = "wows_query_test",
    crate = "wows_query",
    crate_root = "src/lib.rs",
    package = "wows-query",
    version = "0.1.0",
    features = ["download"],
    deps = WOWS_QUERY_DEPS,
    test_deps = WOWS_QUERY_TEST_DEPS,
    buildscript = buildscript,
)

workspace_binary(
    name = "wows_query_jq_worker_bin",
    crate = "wows_query_jq_worker",
    crate_root = "src/bin/wows-query-jq-worker.rs",
