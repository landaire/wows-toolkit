    "//third-party/rust:serde",
    "//third-party/rust:serde_json",
    "//third-party/rust:thiserror",
    "//third-party/rust:tracing",
] + os_select(
    # The cfg(unix) dependency section of Cargo.toml.
    macos = ["//third-party/rust:rustix"],
    # The cfg(unix) and cfg(target_os = "linux") dependency sections.
    linux = ["//third-party/rust:landlock", "//third-party/rust:rustix"],
