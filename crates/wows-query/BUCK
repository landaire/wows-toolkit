load("//build-support/buck:workspace_rules.bzl", "os_select", "workspace_binary", "workspace_buildscript", "workspace_integration_tests", "workspace_library", "workspace_test")

buildscript = workspace_buildscript(
    name = "wows-query-buildscript",
    crate = "wows_query",
    package = "wows-query",
    version = "0.1.0",
    deps = [
        "//third-party/rust:serde",
        "//third-party/rust:toml",
    ],
)

WOWS_QUERY_DEPS = [
    "//crates/replayshark:replayshark",
    "//crates/wows-core:wows_core",
    "//crates/wows-data-mgr:wows_data_mgr",
    "//crates/wows-replays:wows_replays",
