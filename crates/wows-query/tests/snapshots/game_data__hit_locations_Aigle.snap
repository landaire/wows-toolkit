        saturates: true
        pool_hp: 1000
        share_of_ship_hp_pct: 5.9
        penetration_damage_pct: 33
        saturated_damage_pct: 16.5
        drains: hull pool
        repairable_pct: 50
      - section: hull pool
        game_key: Hull
