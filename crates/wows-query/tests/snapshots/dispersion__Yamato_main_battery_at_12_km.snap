ship:
  name: Yamato
  index: PJSB018
  tier: 10
  class: battleship
  nation: Japan
  group: upgradeable
  category: tech_tree
  status: released
  replicas:
    - ARP Yamato
    - Yamato Kai
battery: main_battery
range_km: 12
conclusion: "At 12 km, a 39.2% longer main battery range (26.63 km to 37.07 km with Spotting Aircraft + Gun Fire Control System Modification 2) shrinks vertical dispersion from 95.5 m to 78.2 m; horizontal is unchanged at 170.4 m. Aiming Systems Modification 1 narrows both: horizontal 170.4 m to 158.5 m, vertical 95.5 m to 88.8 m."
guns:
  - mount: main battery
    min_radius: 2.8
    ideal_radius: 10
    ideal_distance: 1000
    radius_on_zero: 0.2
    radius_on_delim: 0.6
    radius_on_max: 0.8
    delim: 0.5
builds:
  - build: base
    kind: base
    max_range_km: 26.63
    mounts:
      - mount: main battery
        at_range:
          ellipse:
            horizontal_m: 170.4
            vertical_m: 95.5
            vertical_ratio: 0.56
  - build: Spotting Aircraft
    kind: range
    max_range_km: 31.96
    max_range_change_pct: 20
    mounts:
      - mount: main battery
        at_range:
          ellipse:
            horizontal_m: 170.4
            vertical_m: 85.3
            vertical_ratio: 0.5
            horizontal_change_pct: 0
            vertical_change_pct: -10.7
  - build: Gun Fire Control System Modification 2
    kind: range
    max_range_km: 30.89
    max_range_change_pct: 16
    mounts:
      - mount: main battery
        at_range:
          ellipse:
            horizontal_m: 170.4
            vertical_m: 87
            vertical_ratio: 0.511
            horizontal_change_pct: 0
            vertical_change_pct: -8.9
  - build: Aiming Systems Modification 1
    kind: accuracy
    max_range_km: 26.63
    max_range_change_pct: 0
    mounts:
      - mount: main battery
        at_range:
          ellipse:
            horizontal_m: 158.5
            vertical_m: 88.8
            vertical_ratio: 0.56
            horizontal_change_pct: -7
            vertical_change_pct: -7
  - build: Main Battery Director System (unique upgrade)
    kind: accuracy
