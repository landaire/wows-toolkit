      torpedoes_per_minute: "2.94 (rank 4/6, p40)"
      torpedo_reload: "81.6 (rank 3/6, p60)"
      torpedo_launch_from_bow: "31 (rank 3/6, p60)"
      broadside_tubes: "4 (rank 3/6, p20)"
      aa_damage: "1008 (rank 7/43, p86)"
      aa_range: "5.8 (rank 21/43, p17)"
      concealment: "10.6 (rank 1/43, p100)"
      air_concealment: "8.1 (rank 1/43, p2)"
      speed: "33 (rank 7/43, p81)"
