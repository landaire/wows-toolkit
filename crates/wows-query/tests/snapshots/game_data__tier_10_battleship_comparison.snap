      turning_circle: "1160 (rank 43/43, p0)"
    outliers:
      - "health 70000 HP: worse than 95% of the 42 other tier 10 battleships (rank 41/43)"
      - "repair_party_heal 40%: better than 95% of the 41 other tier 10 battleships (rank 1/42)"
