    "//crates/wgc-auth:wgc-auth",
    "//crates/wgc-catalog:wgc-catalog",
    "//crates/wgc-download:wgc-download",
    "//crates/wgc-install:wgc-install",
    "//crates/wows-toolkit-config:wows_toolkit_config",
    "//crates/wows-toolkit-hardening:wows_toolkit_hardening",
    "//crates/wows-toolkit-icons:wows_toolkit_icons",
    "//crates/wows-toolkit-launcher:wows_toolkit_launcher",
    "//crates/wows-toolkit-replay-data:wows_toolkit_replay_data",
    "//crates/wows-toolkit-services:wows_toolkit_services",
    "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel",
    "//crates/wt-translations:wt_translations",
    "//third-party/rust:clap",
    "//third-party/rust:futures",
    "//third-party/rust:humansize",
    "//third-party/rust:rootcause",
    "//third-party/rust:rust-i18n",
    "//third-party/rust:rustls",
    "//third-party/rust:serde",
    "//third-party/rust:serde_json",
