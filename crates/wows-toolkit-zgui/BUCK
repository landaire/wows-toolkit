load("//build-support/buck:workspace_rules.bzl", "LINUX_GUI_RUSTC_FLAGS", "os_select", "workspace_binary", "workspace_buildscript", "workspace_test")

buildscript = workspace_buildscript(
    name = "zgui_build",
    crate = "wows_toolkit_zgui",
    package = "wows-toolkit-zgui",
    version = "1.0.5",
    rustc_flags = ["--cfg=wows_buck_build"],
)

ZGUI_DEPS = [
