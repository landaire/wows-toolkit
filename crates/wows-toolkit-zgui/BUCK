    "//third-party/rust:zgui-ui-primitives",
    "//third-party/rust:zgui-ui-tokens",
]

# Not wows_toolkit_zgui_bin: the target name is a path component of every object file a release
# build writes, and the longest of those already sits near the 260 link.exe accepts.
workspace_binary(
    name = "zgui_bin",
    crate = "wows_toolkit_zgui",
    package = "wows-toolkit-zgui",
    version = "1.0.5",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    deps = ZGUI_DEPS,
    rustc_flags = os_select(
        macos = [],
        linux = LINUX_GUI_RUSTC_FLAGS,
        windows = ["-Clink-arg=$(location toolchains//windows:app_resource)"],
    ),
)

_TEST_SUPPORT_VARIANTS = {
    "//crates/landaire-ui:landaire_ui": "//crates/landaire-ui:landaire_ui_test_support",
    "//crates/wows-toolkit-config:wows_toolkit_config": "//crates/wows-toolkit-config:wows_toolkit_config_test_support",
    "//crates/wows-toolkit-services:wows_toolkit_services": "//crates/wows-toolkit-services:wows_toolkit_services_test_support",
}

workspace_test(
    name = "zgui_test",
    crate = "wows_toolkit_zgui",
    package = "wows-toolkit-zgui",
    version = "1.0.5",
    crate_root = "src/main.rs",
    buildscript = buildscript,
    # test-support lets the tests point `storage_dir` at a temporary directory and open the shell
    # headlessly.
    deps = [_TEST_SUPPORT_VARIANTS.get(d, d) for d in ZGUI_DEPS],
    test_deps = ["//crates/wowsunpack:wowsunpack", "//third-party/rust:image", "//third-party/rust:tempfile"],
    incoming_transition = "//build-support/buck/test-support:transition",
    # Each test opens a window. One thread per core wedges the run on a machine with many of them.
    run_env = {"RUST_TEST_THREADS": "4"},
)
