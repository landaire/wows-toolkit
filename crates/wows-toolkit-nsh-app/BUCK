load("//build-support/buck:workspace_rules.bzl", "os_select", "workspace_binary")

# Cargo bundles the TSX interface in build.rs; Buck has the same bundle built
# by //crates/wows-toolkit-nsh:nsh_ui_bundle and names it the same way.
workspace_binary(
    name = "nsh_bin",
    crate = "wows_toolkit_nsh",
    package = "wows-toolkit-nsh-app",
    version = "1.0.3",
    crate_root = "src/main.rs",
    env = {"NSH_BUNDLE_PATH": "$(location //crates/wows-toolkit-nsh:nsh_ui_bundle)"},
    deps = [
        "//crates/wows-toolkit-config:wows_toolkit_config",
        "//crates/wows-toolkit-nsh:wows_toolkit_nsh",
        "//crates/wows-toolkit-viewmodel:wows_toolkit_viewmodel",
        "//third-party/rust:log",
        "//third-party/rust:nsh-base",
        "//third-party/rust:rustls",
        "//third-party/rust:serde_json",
    ] + os_select(
        macos = [],
        linux = ["//third-party/rust:nsh-platform-linux"],
        windows = [],
    ),
)
