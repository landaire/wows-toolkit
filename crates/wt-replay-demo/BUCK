# The replay demo the site embeds. The page loads it from its own directory,
# so the module and glue are fetched relative to it.
wasm_site(
    name = "site",
    index = "index.html",
    module = ":wt_replay_demo[cdylib]",
    out_name = "wt-replay-demo",
    public_url = "./",
    target_compatible_with = wasm_target_compatible_with(),
    visibility = ["PUBLIC"],
    # The proposals rustc enables by default for wasm32-unknown-unknown; see
    # //crates/wt-web:site.
    wasm_opt_flags = [
        "-O2",
        "--enable-bulk-memory",
        "--enable-multivalue",
        "--enable-mutable-globals",
        "--enable-nontrapping-float-to-int",
        "--enable-reference-types",
        "--enable-sign-ext",
    ],
)
