platform(
    name = "macos_arm64",
    constraint_values = [
        "config//os/constraints:macos",
        "config//cpu/constraints:arm64",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "config//os/constraints:linux",
        "config//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

alias(
    name = "windows_x86_64_msvc",
    actual = "//windows:windows_x86_64_msvc",
    visibility = ["PUBLIC"],
)

# wt-web's browser target. Nothing builds for it by default: wasm targets reach
# it through //build-support/buck/wasm:transition.
platform(
    name = "wasm32",
    constraint_values = [
        "config//os/constraints:os[none]",
        "config//cpu/constraints:cpu[wasm32]",
    ],
    visibility = ["PUBLIC"],
)
