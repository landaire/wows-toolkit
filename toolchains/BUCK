# wgc-relay and the wgc.exe placeholder, which the Linux launcher runs under
# Wine. The Nix rustc compiles them against the x86_64-pc-windows-gnu standard
# library and links them with the Nix ld.lld against the MinGW runtime and
# import libraries. Both come from the Rust release of that rustc and move with
# it; scripts/refresh-buck-toolchain.nu fails until they match. The hashes are
# in https://static.rust-lang.org/dist/channel-rust-<version>.toml.
http_archive(
    name = "rust_std_windows_gnu",
    exec_compatible_with = WINDOWS_CROSS_EXEC_COMPATIBLE_WITH,
    sha256 = "f96259e34f86f270d75944cfd870b40003c9601678269a2751708e5a0000ab06",
    strip_prefix = "rust-std-1.100.0-x86_64-pc-windows-gnu/rust-std-x86_64-pc-windows-gnu",
    urls = ["https://static.rust-lang.org/dist/2026-11-12/rust-std-1.100.0-x86_64-pc-windows-gnu.tar.xz"],
)

http_archive(
    name = "rust_mingw_windows_gnu",
    exec_compatible_with = WINDOWS_CROSS_EXEC_COMPATIBLE_WITH,
    sha256 = "5491d2ad03b0f124307c8b2c4ac840b65e738a348f4381975f0e638b012e4ae9",
    strip_prefix = "rust-mingw-1.100.0-x86_64-pc-windows-gnu/rust-mingw/lib/rustlib/x86_64-pc-windows-gnu/lib/self-contained",
    urls = ["https://static.rust-lang.org/dist/2026-11-12/rust-mingw-1.100.0-x86_64-pc-windows-gnu.tar.xz"],
)

windows_gnu_cxx_toolchain(
    name = "nix_cxx_windows_gnu",
    mingw_libraries = ":rust_mingw_windows_gnu",
    visibility = ["PUBLIC"],
)

