    visibility = ["PUBLIC"],
)

hermetic_rustfmt(
    name = "rustfmt",
    visibility = ["PUBLIC"],
)

# rust_test requires it. The prelude's own no-op is right here: it exists to
# report a sanitizer to test infra, and nothing in this repo builds sanitized.
noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

local_remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

nix_wasm_tools(
    name = "wasm_tools",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_macos",
    default_edition = "2024",
    rustc_target_triple = "aarch64-apple-darwin",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_linux",
    default_edition = "2024",
    rustc_target_triple = "x86_64-unknown-linux-gnu",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_wasm32",
    default_edition = "2024",
    rustc_target_triple = "wasm32-unknown-unknown",
    visibility = ["PUBLIC"],
)

selected_toolchain(
    name = "cxx",
    actual = select({
        "config//os/constraints:linux": ":nix_cxx_linux",
        "config//os/constraints:macos": ":nix_cxx_macos",
        "config//os/constraints:windows": "//windows:cxx",
        # wt-web. The Nix toolchain builds it, so it needs a Linux or macOS host.
        "config//cpu/constraints:wasm32": ":nix_cxx_wasm32",
    }),
    visibility = ["PUBLIC"],
)

selected_toolchain(
    name = "rust",
    actual = select({
        "config//os/constraints:linux": ":nix_rust_linux",
        "config//os/constraints:macos": ":nix_rust_macos",
        "config//os/constraints:windows": "//windows:rust",
        "config//cpu/constraints:wasm32": ":nix_rust_wasm32",
    }),
    visibility = ["PUBLIC"],
)

# The build mode, set by the `debug` and `release` modifiers (see the root
# PACKAGE). A configuration without either builds debug.
constraint_setting(
    name = "native_build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "debug",
    constraint_setting = ":native_build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "release",
    constraint_setting = ":native_build_mode",
    visibility = ["PUBLIC"],
)
