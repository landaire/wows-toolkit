hermetic_rust_toolchain(
    name = "nix_rust_macos",
    default_edition = "2024",
    rustc_target_triple = "aarch64-apple-darwin",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_linux",
    default_edition = "2024",
    rustc_target_triple = "x86_64-unknown-linux-gnu",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_wasm32",
    default_edition = "2024",
    rustc_target_triple = "wasm32-unknown-unknown",
    visibility = ["PUBLIC"],
)

hermetic_rust_toolchain(
    name = "nix_rust_windows_gnu",
    default_edition = "2024",
    dlltool = "llvm-dlltool",
    exec_compatible_with = WINDOWS_CROSS_EXEC_COMPATIBLE_WITH,
    rustc_flags = [
        # The linker is ld.lld itself, not a C compiler driver.
        "-Clinker-flavor=ld",
        # The C runtime startup objects come from the sysroot, where a driver
        # would have supplied its own.
        "-Clink-self-contained=yes",
    ],
    rustc_target_triple = "x86_64-pc-windows-gnu",
    sysroot = ":rust_std_windows_gnu",
    visibility = ["PUBLIC"],
)

# Refines the plain Windows key below, so the GNU ABI selects the cross
# toolchain and every other Windows configuration keeps MSVC.
config_setting(
    name = "windows_gnu",
    constraint_values = [
        "config//os/constraints:windows",
        "prelude//abi/constraints:gnu",
    ],
    visibility = ["PUBLIC"],
)

selected_toolchain(
    name = "cxx",
    actual = select({
        "config//os/constraints:linux": ":nix_cxx_linux",
        "config//os/constraints:macos": ":nix_cxx_macos",
        "config//os/constraints:windows": "//windows:cxx",
        ":windows_gnu": ":nix_cxx_windows_gnu",
        # wt-web. The Nix toolchain builds it, so it needs a Linux or macOS host.
        "config//cpu/constraints:cpu[wasm32]": ":nix_cxx_wasm32",
    }),
    visibility = ["PUBLIC"],
)

selected_toolchain(
    name = "rust",
    actual = select({
        "config//os/constraints:linux": ":nix_rust_linux",
        "config//os/constraints:macos": ":nix_rust_macos",
        "config//os/constraints:windows": "//windows:rust",
        ":windows_gnu": ":nix_rust_windows_gnu",
        "config//cpu/constraints:cpu[wasm32]": ":nix_rust_wasm32",
    }),
    visibility = ["PUBLIC"],
)

# The build mode, set by the `debug` and `release` modifiers (see the root
# PACKAGE). A configuration without either builds debug.
constraint_setting(
    name = "native_build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "debug",
    constraint_setting = ":native_build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "release",
    constraint_setting = ":native_build_mode",
    visibility = ["PUBLIC"],
)
