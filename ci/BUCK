# Clippy and rustfmt over every first-party Rust target.
nu_script(
    name = "lint",
    script = "//scripts:lint.nu",
)

# The action graph of every root alias, in both build modes, holds nothing that
# reaches outside its declared inputs.
nu_script(
    name = "hermetic",
    script = "hermetic.nu",
    srcs = ["//scripts:check-buck-hermetic.nu"],
)

# Every root alias builds files whose runpaths name only the store and
# themselves, whatever shell started the Buck daemon.
nu_script(
    name = "runpath",
    script = "runpath.nu",
    srcs = ["//scripts:check-buck-runpath.nu"],
)

# The tests of the build graph itself, scripts/test-*.nu.
nu_script(
    name = "graph_tests",
    script = "graph-tests.nu",
    srcs = ["//scripts:graph_tests"],
)

# The first-party targets a change affects; see affected.nu.
nu_script(
    name = "affected",
    script = "affected.nu",
)
